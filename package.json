{
  "name": "matterbridge-protoart",
  "version": "0.5.1",
  "description": "Matterbridge plugin for ProtoArt ME_CN105_ATA_WIFI heat pumps",
  "author": "@maxbengtzen",
  "license": "MIT",
  "type": "module",
  "main": "dist/module.js",
  "exports": {
    ".": {
      "import": "./dist/module.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxbengtzen/matterbridge-protoart.git"
  },
  "homepage": "https://github.com/maxbengtzen/matterbridge-protoart#readme",
  "bugs": {
    "url": "https://github.com/maxbengtzen/matterbridge-protoart/issues"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "keywords": [
    "matterbridge",
    "matter",
    "protoart",
    "heat-pump",
    "thermostat"
  ],
  "scripts": {
    "setup": "npm install --no-save --no-fund --no-audit matterbridge@3.10.13",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --test \"test/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build",
    "preversion": "node scripts/changelog.ts check && npm run check",
    "version": "node scripts/changelog.ts release && npm run build && git add CHANGELOG.md dist"
  },
  "files": [
    "dist",
    "matterbridge-protoart.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
